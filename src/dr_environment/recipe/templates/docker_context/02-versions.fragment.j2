# Tool versions from recipe .datarobot/cli/versions.yaml (minimum-version fields).
FROM user AS versions

ARG UNAME=notebooks
ARG CLI_VERSION={{ dr_version }}
ARG UV_VERSION={{ uv_version }}
ARG NODE_VERSION={{ node_version }}
ARG GIT_MIN_VERSION={{ git_version }}
ARG TASK_VERSION={{ task_version }}
ARG PULUMI_VERSION={{ pulumi_version }}
ARG OPENCODE_VERSION={{ opencode_version }}
ARG COPIER_VERSION={{ copier_version }}
ARG DATAROBOT_VERSION={{ datarobot_version }}
ARG PULUMI_DATAROBOT_VERSION={{ pulumi_datarobot_version }}
ARG PULUMI_COMMAND_VERSION={{ pulumi_command_version }}

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# versions.yaml — git (minimum {{ git_version }}; Wolfi apk ships the current stable release)
# hadolint ignore=DL3018,DL3059
RUN apk add --no-cache git

# TEMPORARY WORKAROUND: bundle the GitHub CLI. Remove once it is no longer needed.
# hadolint ignore=DL3018,DL3059
RUN apk add --no-cache gh

USER $UNAME
# UV_CACHE_DIR points at the baked offline cache so tools installed here (copier,
# datarobot) and their wheels land where the runtime (UV_OFFLINE=1) looks for them.
# UV_PYTHON_PREFERENCE=system keeps every uv operation on the image's system CPython
# (3.11). Otherwise, under uv's default `managed` preference, steps that request Python
# 3.11 — the Agent Assist venv below and the ephemeral `uvx copier` resolve run by
# `dr start` — would each download a separate managed CPython instead of reusing the
# system one, adding an unneeded interpreter and (offline) resolving against uncached
# wheels. System Python is the interpreter the offline cache was populated for.
ENV HOME=/home/notebooks \
    PATH="/home/notebooks/.local/bin:$PATH" \
    UV_CACHE_DIR=/opt/cache/uv \
    UV_PYTHON_PREFERENCE=system

# versions.yaml — uv ({{ uv_version }})
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_VERSION="{{ uv_version }}" sh

# copier ({{ copier_version }}; default when not listed in recipe)
RUN uv tool install "copier=={{ copier_version }}"

# Warm the `uvx copier` ephemeral environment so `dr start` (which runs bare
# `uvx copier recopy`) can resolve copier and its whole dependency tree from the
# baked cache offline. Invoked bare to match `dr start`, and — thanks to
# UV_PYTHON_PREFERENCE=system above — resolved against the same system CPython the
# runtime uses.
RUN uvx copier --version

# Also download copier's full dependency closure into the shared wheelhouse
# (find-links, see 99-offline). The uv cache warm-up above is keyed to whatever index
# this build resolved against, so it's invisible to an install that points UV_INDEX_URL
# at its own mirror instead. Find-links reads wheels straight off disk with no
# index/URL/network involved, so it resolves regardless of what UV_INDEX_URL is set to.
# --only-binary=:all: fails this build step loudly if a future copier release pulls in
# a transitive dep with no published wheel, instead of silently baking an sdist that
# would need a working compiler toolchain to build offline at the customer's runtime.
RUN venv=/tmp/copier-wheelhouse-warm \
    && uv venv "$venv" \
    && uv pip install --python "$venv/bin/python" pip \
    && "$venv/bin/python" -m pip download --only-binary=:all: "copier=={{ copier_version }}" --dest /opt/wheelhouse \
    && rm -rf "$venv"

# datarobot ({{ datarobot_version }}; default when not listed in recipe)
RUN uv tool install --force "datarobot[core]>={{ datarobot_version }}"

# versions.yaml — task ({{ task_version }})
RUN sh -c "$(curl --location https://taskfile.dev/install.sh)" -- -d -b /home/notebooks/.local/bin v{{ task_version }}

# versions.yaml — node ({{ node_version }})
RUN mkdir -p /home/notebooks/.local \
    && curl -fsSL "https://nodejs.org/dist/{{ node_version }}/node-{{ node_version }}-linux-x64.tar.xz" \
    | tar -xJ -C /home/notebooks/.local --strip-components=1

# versions.yaml — dr CLI ({{ dr_version }})
RUN curl -fsSL -o /tmp/dr.tar.gz \
    "https://github.com/datarobot-oss/cli/releases/download/{{ dr_version }}/dr_{{ dr_version }}_Linux_x86_64.tar.gz" \
    && mkdir -p /tmp/dr-extract /home/notebooks/.local/bin \
    && tar -xzf /tmp/dr.tar.gz -C /tmp/dr-extract \
    && install -m 755 /tmp/dr-extract/dr /home/notebooks/.local/bin/dr \
    && rm -rf /tmp/dr-extract /tmp/dr.tar.gz

RUN dr plugin install xp \
    && dr plugin install opencode \
    && dr plugin install assist

# Pre-create the Agent Assist venv under the name dr-assist derives at runtime (the
# wheel basename without .whl). Agent Assist builds this venv on first launch, which
# fails in the offline image; baking it here lets it start. `uv venv` uses the system
# interpreter (3.11), which matches the plugin's cp311 wheel.
# ~/.cache already exists root-owned from an earlier build step, so hand it to the
# runtime user before creating the venv inside it.
USER root
RUN install -d -o "$UNAME" -g "$UNAME" /home/notebooks/.cache
USER $UNAME
RUN wheel=$(echo /home/notebooks/.config/datarobot/plugins/assist/dr_assist-*-cp311-cp311-manylinux*_x86_64*.whl) \
    && venv_dir="/home/notebooks/.cache/dr-assist-venv-$(basename "$wheel" .whl)" \
    && uv venv "$venv_dir" \
    && uv pip install --python "$venv_dir/bin/python" "$wheel"

# versions.yaml — pulumi ({{ pulumi_version }})
RUN curl -fsSL https://get.pulumi.com | sh -s -- \
    --version "$PULUMI_VERSION" \
    --install-root /home/notebooks/.local

RUN pulumi login --local

# pulumi-datarobot provider ({{ pulumi_datarobot_version }}; not in versions.yaml, default when not listed in recipe)
RUN pulumi plugin install resource datarobot "$PULUMI_DATAROBOT_VERSION" \
    --server github://api.github.com/datarobot-community/pulumi-datarobot

# pulumi command provider ({{ pulumi_command_version }}; not in versions.yaml, default when not listed in recipe)
RUN pulumi plugin install resource command "$PULUMI_COMMAND_VERSION"

# versions.yaml — opencode ({{ opencode_version }})
RUN curl -fsSL -o /tmp/opencode-install.sh https://opencode.ai/install \
    && bash /tmp/opencode-install.sh --no-modify-path -v "$OPENCODE_VERSION" \
    && rm /tmp/opencode-install.sh

ENV PATH="/home/notebooks/.local/bin:$PATH"
