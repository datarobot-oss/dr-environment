ARG WORKDIR=/etc/system/kernel
ARG AGENTDIR=/etc/system/kernel/agent
ARG VENV_PATH=${WORKDIR}/.venv
ARG UNAME=notebooks
ARG UID=10101
ARG GID=10101
ARG CLI_VERSION={{ cli_version }}
ARG OPENCODE_VERSION={{ opencode_version }}
ARG UV_CACHE_DIR={{ uv_cache_dir }}
ARG PYTHON_VERSION={{ python_version }}
ARG TARGETPLATFORM={{ target_platform }}

# Open-source Wolfi + Python stack (see datarobot-user-models Dockerfile.local).
# DataRobot notebook kernels deploy on linux/amd64; pin platform to avoid arm64 exec format errors.
# hadolint ignore=DL3007
FROM --platform=${TARGETPLATFORM} cgr.dev/chainguard/wolfi-base:latest AS wolfi_python_dev

ARG PYTHON_VERSION
SHELL ["/bin/sh", "-o", "pipefail", "-c"]

ENV PATH="${PATH}:/sbin"
RUN apk update && apk upgrade
# Wolfi python runtime
# hadolint ignore=DL3018,DL3059
RUN apk add --no-cache ca-certificates-bundle gdbm glibc glibc-locale-posix \
    ld-linux libbz2-1 libcrypto3 libexpat1 libffi libgcc libssl3 libstdc++ \
    mpdecimal ncurses ncurses-terminfo readline sqlite-libs \
    wolfi-baselayout xz zlib
# Wolfi python build toolchain
# hadolint ignore=DL3018,DL3059
RUN apk add --no-cache apk-tools bash binutils build-base busybox cyrus-sasl \
    gcc git glibc-dev gmp heimdal-libs isl keyutils-libs krb5-conf krb5-libs \
    libatomic libbrotlicommon1 libbrotlidec1 libcom_err libcrypt1 \
    libcurl-openssl4 libgo libgomp libidn2 libldap libnghttp2-14 libpcre2-8-0 \
    libpsl libquadmath libstdc++-dev libunistring libverto libxcrypt libxcrypt-dev \
    libzstd1 linux-headers make mpc mpfr nss-db nss-hesiod openssf-compiler-options \
    pkgconf posix-cc-wrappers wget
# Python {{ python_version }}
# hadolint ignore=DL3018,DL3059
RUN apk add --no-cache \
    python-${PYTHON_VERSION} \
    python-${PYTHON_VERSION}-base \
    py${PYTHON_VERSION}-pip \
    py3-pip-wheel
# Python {{ python_version }} dev headers
# hadolint ignore=DL3018,DL3059
RUN apk add --no-cache python-${PYTHON_VERSION}-dev \
    python-${PYTHON_VERSION}-base-dev \
    py${PYTHON_VERSION}-pip-base \
    py${PYTHON_VERSION}-setuptools

FROM wolfi_python_dev AS base

ARG UNAME
ARG UID
ARG GID
ARG WORKDIR
ARG AGENTDIR
ARG VENV_PATH
ARG UV_CACHE_DIR

USER root

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# hadolint ignore=DL3018,DL3059
RUN apk add --no-cache task
# hadolint ignore=DL3018,DL3059
RUN apk add --no-cache uv graphviz openblas openssh-server \
    gzip zip unzip curl git \
    openjdk-11 vim nano procps tzdata nodejs npm \
    && rm -f /etc/ssh/ssh_host_*
# hadolint ignore=DL3018,DL3059
RUN apk add --no-cache rust sqlite go

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPYCACHEPREFIX=/tmp/.python_cache \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    VENV_PATH=${VENV_PATH} \
    PIP_NO_CACHE_DIR=1 \
    NOTEBOOKS_KERNEL="python" \
    DEEPEVAL_HOME=/tmp/.deepeval \
    DEEPEVAL_TELEMETRY_OPT_OUT="YES"

ENV PATH="$VENV_PATH/bin:$PATH" \
    PYTHONPATH="/home/notebooks/.ipython/extensions:/home/notebooks/storage"

RUN uv venv ${VENV_PATH}
COPY kernel/requirements.txt /tmp/kernel/requirements.txt
RUN . ${VENV_PATH}/bin/activate && uv pip install -r /tmp/kernel/requirements.txt
WORKDIR ${WORKDIR}

COPY ./agent/agent.py ./agent/cgroup_watchers.py ${AGENTDIR}/
COPY ./jupyter_kernel_gateway_config.py ${WORKDIR}/jupyter_kernel_gateway_config.py
COPY ./start_server_codespaces.sh ${WORKDIR}/start_server.sh
RUN chmod a+x ${WORKDIR}/start_server.sh
COPY ./kernel.json ${VENV_PATH}/share/jupyter/kernels/python3/

COPY ./ipython_config.py /etc/ipython/
COPY ./extensions /etc/ipython/extensions

COPY ./sshd_config /etc/ssh/
RUN cp -a /etc/ssh /etc/ssh.cache
RUN mkdir /etc/authorized_keys

RUN addgroup -g "$GID" "$UNAME" && \
    adduser -D -u "$UID" -G "$UNAME" -s /bin/bash "$UNAME"

COPY ./setup-prompt.sh /etc/profile.d/setup-prompt.sh
COPY ./setup-ssh.sh ./common-user-limits.sh ./setup-venv.sh ./setup-caches.sh ${WORKDIR}/
RUN sed -i 's/\r$//' \
    ${WORKDIR}/start_server.sh \
    ${WORKDIR}/setup-ssh.sh \
    ${WORKDIR}/setup-venv.sh \
    ${WORKDIR}/setup-caches.sh \
    ${WORKDIR}/common-user-limits.sh \
    /etc/profile.d/setup-prompt.sh

RUN chown -R $UNAME:$UNAME ${WORKDIR} ${VENV_PATH} /home/notebooks /etc/ssh /etc/authorized_keys \
  && touch /etc/profile.d/notebooks-load-env.sh \
  && chown -R $UNAME:$UNAME /etc/profile.d/notebooks-load-env.sh \
  && touch /etc/profile.d/bash-profile-load.sh \
  && chown -R $UNAME:$UNAME /etc/profile.d/bash-profile-load.sh \
  && mkdir -p "${UV_CACHE_DIR}" /opt/cache/npm /opt/cache/go/pkg/mod /opt/cache/go/build \
  && chown -R "$UNAME:$UNAME" "${UV_CACHE_DIR}" /opt/cache

ENV UV_CACHE_DIR=${UV_CACHE_DIR}

USER $UNAME

EXPOSE 8888
EXPOSE 8889
EXPOSE 22
