{% if fips_base_image -%}
# Generated by dr-environment — built on DataRobot's Chainguard python-fips mirror, which needs DataRobot pull credentials.
{%- else -%}
# Generated by dr-environment — built on the public Wolfi base image, so you can rebuild it yourself.
{%- endif %}

ARG WORKDIR=/etc/system/kernel
ARG AGENTDIR=/etc/system/kernel/agent
ARG VENV_PATH=${WORKDIR}/.venv
ARG UNAME=notebooks
ARG UID=10101
ARG GID=10101
ARG UV_CACHE_DIR={{ uv_cache_dir }}
ARG PYTHON_VERSION={{ python_version }}
ARG TARGETPLATFORM={{ target_platform }}

{% if fips_base_image -%}
# Chainguard python-fips: Wolfi with the FIPS OpenSSL provider and openssl-fips-test, which the
# DataRobot FIPS self-test wrapper runs at container start. It already has the runtime libraries
# (layer 1 is skipped: it would add a second, non-FIPS OpenSSL), Python and most of the toolchain.
# DataRobot notebook kernels deploy on linux/amd64; pin platform to avoid arm64 exec format errors.
FROM --platform=${TARGETPLATFORM} {{ fips_base_image }}:${PYTHON_VERSION}-dev AS wolfi_python_dev
# The image runs as nonroot; apk needs root.
USER root
{%- else -%}
# Open-source Wolfi + Python stack (see datarobot-user-models Dockerfile.local).
# DataRobot notebook kernels deploy on linux/amd64; pin platform to avoid arm64 exec format errors.
# hadolint ignore=DL3007
FROM --platform=${TARGETPLATFORM} cgr.dev/chainguard/wolfi-base:latest AS wolfi_python_dev
{%- endif %}

ARG PYTHON_VERSION
SHELL ["/bin/sh", "-o", "pipefail", "-c"]

ENV PATH="${PATH}:/sbin"
RUN apk update && apk upgrade

# Wolfi layers below mirror datarobot-user-models/python313_notebook — Chainguard splits
# Python into many apk packages; `python-3.11` alone does not install the full stack.
#
{% if not fips_base_image -%}
# Layer 1 — CPython runtime libraries (glibc, openssl, sqlite, readline, etc.)
# hadolint ignore=DL3018,DL3059
RUN apk add --no-cache ca-certificates-bundle gdbm glibc glibc-locale-posix \
    ld-linux libbz2-1 libcrypto3 libexpat1 libffi libgcc libssl3 libstdc++ \
    mpdecimal ncurses ncurses-terminfo readline sqlite-libs \
    wolfi-baselayout xz zlib
{%- endif %}

# Layer 2 — C extension build toolchain (pip/uv compile wheels; not in python-dev alone)
# hadolint ignore=DL3018,DL3059
RUN apk add --no-cache apk-tools bash binutils build-base busybox cyrus-sasl \
    gcc git glibc-dev gmp heimdal-libs isl keyutils-libs krb5-conf krb5-libs \
    libatomic libbrotlicommon1 libbrotlidec1 libcom_err libcrypt1 \
    libcurl-openssl4 libgo libgomp libidn2 libldap libnghttp2-14 libpcre2-8-0 \
    libpsl libquadmath libstdc++-dev libunistring libverto libxcrypt libxcrypt-dev \
    libzstd1 linux-headers make mpc mpfr nss-db nss-hesiod openssf-compiler-options \
    pkgconf posix-cc-wrappers wget

# Layer 3 — Python {{ python_version }} interpreter + pip
# hadolint ignore=DL3018,DL3059
RUN apk add --no-cache \
    python-${PYTHON_VERSION} \
    python-${PYTHON_VERSION}-base \
    py${PYTHON_VERSION}-pip \
    py3-pip-wheel

# Layer 4 — Python {{ python_version }} headers (component wheels may compile at runtime)
# hadolint ignore=DL3018,DL3059
RUN apk add --no-cache python-${PYTHON_VERSION}-dev \
    python-${PYTHON_VERSION}-base-dev \
    py${PYTHON_VERSION}-pip-base \
    py${PYTHON_VERSION}-setuptools

FROM wolfi_python_dev AS base

ARG UNAME
ARG UID
ARG GID
ARG WORKDIR
ARG AGENTDIR
ARG VENV_PATH
ARG UV_CACHE_DIR

USER root

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Runtime utilities for notebook kernel, SSH codespaces, and component caches.
# versions.yaml tools are installed in 02-versions.fragment (after 01-user).
# Notebook/kernel setup is in 03-kernel.fragment.
# hadolint ignore=DL3018,DL3059
RUN apk add --no-cache graphviz openblas openssh-server \
    gzip zip unzip curl wget vim nano procps tzdata \
    && rm -f /etc/ssh/ssh_host_*
# hadolint ignore=DL3018,DL3059
RUN apk add --no-cache rust sqlite go
{% if fips_base_image %}
# FIPS 140-3: keep all crypto in the base's FIPS OpenSSL. Every later stage, and every build
# FROM this image, inherits the settings below.
#
# Swap Chainguard's legacy provider for OpenSSL's default provider: the legacy one lets plain
# hashlib.md5() through. The default provider still serves md5(usedforsecurity=False), which
# hashlib needs at import. Same patch as datarobot/buzok#4816.
RUN sed -i -e '/^CHAINGUARD_LEGACY_ALLOWED = 1$/d' \
           -e 's/^legacy = legacy_sect$/default = default_sect/' \
           -e 's/^\[legacy_sect\]$/[default_sect]/' \
           -e 's/^activate = \$ENV::CHAINGUARD_LEGACY_ALLOWED$/activate = 1/' \
           -e '/^identity = chainguard-fips-allowed$/d' \
           -e '/^module = legacy\.so$/d' \
           -e '/^enable-legacy-allowed = /d' /etc/ssl/openssl.cnf \
    && grep -q '^default = default_sect$' /etc/ssl/openssl.cnf \
    && ! grep -q -e legacy -e CHAINGUARD /etc/ssl/openssl.cnf

# PyPI wheels of cryptography and grpcio carry their own OpenSSL and BoringSSL. uv and pip
# build both from source against the system OpenSSL instead, here and at deploy time.
# CXXFLAGS: Chainguard's -fno-delete-null-pointer-checks breaks the abseil build inside grpcio.
# It applies to every C++ source build, because uv builds grpcio wherever a lockfile needs it.
# GODEBUG: Go binaries (pulumi, task, gh, dr) use Go's own crypto; fips140=on runs its
# self-tests and puts crypto/tls in FIPS settings. fips/sitecustomize.py sets the same.
# hadolint ignore=DL3018
RUN apk add --no-cache openssl-dev
ENV UV_NO_BINARY_PACKAGE="cryptography grpcio" \
    PIP_NO_BINARY="cryptography,grpcio" \
    GRPC_PYTHON_BUILD_SYSTEM_OPENSSL=1 \
    CXXFLAGS=-fdelete-null-pointer-checks \
    GODEBUG=fips140=on,fips140ems=1

# Halts any Python process whose FIPS module fails; on PYTHONPATH in the offline stage.
COPY kernel/fips /etc/datarobot-fips/
{% endif -%}
